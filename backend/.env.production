# ============================================================
# PaperMate 后端 - 生产环境变量
# 用法: 将本文件复制为 backend/.env.production 并填写所有占位符
# ============================================================

APP_NAME=arxiv-PaperMate API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api

# ---- 数据库 (host 网络模式，直连宿主机 127.0.0.1) ----
DATABASE_URL=postgresql+asyncpg://papermate:<填写你设置的数据库密码>@127.0.0.1:5432/papermate

# ---- Redis (host 网络模式，直连宿主机 127.0.0.1) ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_RESULT_BACKEND_URL=redis://127.0.0.1:6379/1
REDIS_COORDINATION_URL=redis://127.0.0.1:6379/2

# ---- 安全 ----
JWT_SECRET_KEY=<填写你生成的 JWT 密钥，如 openssl rand -hex 64>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS (⚠️ 填写你的前端访问地址) ----
CORS_ORIGINS=http://<公网IP>,http://<公网IP>:<前端端口>

# ---- LLM 配置 (⚠️ 填写你的 API Key) ----
LLM_API_KEY=<填写你的 LLM API Key>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- Embedding 配置 (⚠️ 填写你的 API Key) ----
EMBEDDING_API_KEY=<填写你的 Embedding API Key>
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=1536

# ---- 论文分析流水线 ----
ANALYSIS_PROMPT_VERSION=paper-analysis-v1
ANALYSIS_VERSION=v1
ANALYSIS_PARSER_VERSION=pymupdf-pdfplumber-v1
ANALYSIS_PDF_TIMEOUT_SECONDS=45
ANALYSIS_PDF_MAX_BYTES=52428800
ANALYSIS_CHUNK_TARGET_TOKENS=500
ANALYSIS_CHUNK_MAX_TOKENS=600
ANALYSIS_CHUNK_OVERLAP_TOKENS=50
ANALYSIS_MAX_RETRIES=3
ANALYSIS_HEARTBEAT_TIMEOUT_SECONDS=900
ANALYSIS_RECONCILE_INTERVAL_SECONDS=60
ANALYSIS_OUTBOX_BATCH_SIZE=50
ANALYSIS_OUTBOX_LEASE_SECONDS=120
ANALYSIS_RESULT_EXPIRES_SECONDS=86400
ANALYSIS_QUEUE=analysis
ANALYSIS_AUTO_REQUEUE_WORKER_LOST=true
CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

# ---- arXiv API 策略 (⚠️ 填写你的邮箱) ----
ARXIV_USER_AGENT=PaperMate/1.0 (arxiv metadata client)
ARXIV_CONTACT_EMAIL=<填写你的邮箱>
ARXIV_TIMEOUT_SECONDS=60
ARXIV_REQUEST_INTERVAL_SECONDS=3
ARXIV_MAX_RETRIES=3
ARXIV_REDIS_LOCK_TIMEOUT_SECONDS=120
