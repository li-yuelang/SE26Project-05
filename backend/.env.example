APP_NAME=arxiv-PaperMate API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://papermate:papermate@localhost:5432/papermate
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=1536
ANALYSIS_PROMPT_VERSION=paper-analysis-v1
ANALYSIS_VERSION=v1
ANALYSIS_PDF_TIMEOUT_SECONDS=45
ANALYSIS_PDF_MAX_BYTES=52428800
ANALYSIS_CHUNK_TARGET_TOKENS=500
ANALYSIS_CHUNK_MAX_TOKENS=600
ANALYSIS_CHUNK_OVERLAP_TOKENS=50
ANALYSIS_MAX_RETRIES=3
