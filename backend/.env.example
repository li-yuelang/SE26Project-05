APP_NAME=arxiv-PaperMate API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://papermate:papermate@localhost:5432/papermate
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM / OpenAI ----
OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=          # 留空用官方 API，也可填代理/中转地址
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096
