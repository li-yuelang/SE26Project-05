APP_NAME=arxiv-PaperMate API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://papermate:papermate@localhost:5432/papermate
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1
REDIS_COORDINATION_URL=redis://localhost:6379/2
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- OpenAI-compatible LLM / embeddings ----
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://ws-0dva9v1afcn929i8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=1536
ANALYSIS_PROMPT_VERSION=paper-analysis-v1
ANALYSIS_VERSION=v1
ANALYSIS_PDF_TIMEOUT_SECONDS=45
ANALYSIS_PDF_MAX_BYTES=52428800
ANALYSIS_CHUNK_TARGET_TOKENS=500
ANALYSIS_CHUNK_MAX_TOKENS=600
ANALYSIS_CHUNK_OVERLAP_TOKENS=50
ANALYSIS_MAX_RETRIES=3
ANALYSIS_HEARTBEAT_TIMEOUT_SECONDS=900
ANALYSIS_RECONCILE_INTERVAL_SECONDS=60
ANALYSIS_OUTBOX_BATCH_SIZE=50
ANALYSIS_OUTBOX_LEASE_SECONDS=120
ANALYSIS_RESULT_EXPIRES_SECONDS=86400
ANALYSIS_QUEUE=analysis
ANALYSIS_PARSER_VERSION=pymupdf-pdfplumber-v1
ANALYSIS_AUTO_REQUEUE_WORKER_LOST=true
CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

# ---- arXiv API client ----
ARXIV_USER_AGENT=PaperMate/1.0 (arxiv metadata client)
ARXIV_CONTACT_EMAIL=
ARXIV_TIMEOUT_SECONDS=60
ARXIV_REQUEST_INTERVAL_SECONDS=3
ARXIV_MAX_RETRIES=3
ARXIV_REDIS_LOCK_TIMEOUT_SECONDS=120
DIGEST_ARXIV_SYNC_HOUR=7
DIGEST_ARXIV_SYNC_MINUTE=0
DIGEST_ARXIV_LOOKBACK_HOURS=24
DIGEST_ARXIV_MAX_RESULTS_PER_SUBSCRIPTION=50
