APP_NAME=arxiv-PaperMate API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api

# Compose service names; replace the password and secrets before deployment.
DATABASE_URL=postgresql+asyncpg://papermate:REPLACE_DB_PASSWORD@postgres:5432/papermate
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND_URL=redis://redis:6379/1
REDIS_COORDINATION_URL=redis://redis:6379/2
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://your-frontend.example

LLM_API_KEY=REPLACE_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
EMBEDDING_API_KEY=REPLACE_EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=1536

ANALYSIS_PROMPT_VERSION=paper-analysis-v1
ANALYSIS_VERSION=v1
ANALYSIS_PARSER_VERSION=pymupdf-pdfplumber-v1
ANALYSIS_PDF_TIMEOUT_SECONDS=45
ANALYSIS_PDF_MAX_BYTES=52428800
ANALYSIS_CHUNK_TARGET_TOKENS=500
ANALYSIS_CHUNK_MAX_TOKENS=600
ANALYSIS_CHUNK_OVERLAP_TOKENS=50
ANALYSIS_MAX_RETRIES=3
ANALYSIS_HEARTBEAT_TIMEOUT_SECONDS=900
ANALYSIS_RECONCILE_INTERVAL_SECONDS=60
ANALYSIS_OUTBOX_BATCH_SIZE=50
ANALYSIS_OUTBOX_LEASE_SECONDS=120
ANALYSIS_RESULT_EXPIRES_SECONDS=86400
ANALYSIS_QUEUE=analysis
ANALYSIS_AUTO_REQUEUE_WORKER_LOST=true
CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

ARXIV_USER_AGENT=PaperMate/1.0 (arxiv metadata client)
ARXIV_CONTACT_EMAIL=
ARXIV_TIMEOUT_SECONDS=60
ARXIV_REQUEST_INTERVAL_SECONDS=3
ARXIV_MAX_RETRIES=3
ARXIV_REDIS_LOCK_TIMEOUT_SECONDS=120
