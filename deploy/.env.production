# ============================================================
# PaperMate 云端部署 - 环境变量配置
# 请根据你的云服务器环境填写以下变量
# ============================================================

# ---- 基础配置 ----
APP_NAME="arxiv-PaperMate API"
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api

# ---- 数据库 (PostgreSQL) ----
# 云端的 PostgreSQL 已通过 Docker 运行，端口映射到宿主机 5432
# 请填写正确的 用户名、密码、数据库名
DATABASE_URL=postgresql+asyncpg://papermate:1a838d728b6a46cb5197918a0d0ca9a5e26d3a508b8d911873dd03d20ec623cd@127.0.0.1:5432/papermate

# ---- Redis ----
# 云端的 Redis 已通过 Docker 运行，端口映射到宿主机 6379
# 若 Redis 有密码，格式为: redis://:<PASSWORD>@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_RESULT_BACKEND_URL=redis://127.0.0.1:6379/1
REDIS_COORDINATION_URL=redis://127.0.0.1:6379/2

# ---- JWT 认证 ----
# 请生成一个随机长字符串（建议 64 字符以上）
# 生成方式: openssl rand -hex 64
JWT_SECRET_KEY=81534416cc6f9b192c5409eb5358078b2ad73c9e98c675e562bb51bbbc372a6f59f0edfe1351152d4ed32babe4f90ec513860dae15e89f8df8ac92fdf177ec0f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS 跨域 ----
# 使用浮动 IP 访问，允许所有来源（部署后替换为具体 IP）
# 例如: CORS_ORIGINS=http://你的浮动IP
CORS_ORIGINS=*

# ---- LLM 大模型配置 ----
# 填写你的 LLM API Key 和接口地址
LLM_API_KEY=sk-621d8017b5124114ac7c7cfdd7044841
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- Embedding 向量模型配置 ----
# 填写你的 Embedding API Key 和接口地址
EMBEDDING_API_KEY=sk-ws-H.EILLXEM.8roQ.MEUCIQDE7vPa7RIeikYv0qEy-hwepwaMNY-izK3nFdqhpQ74NgIgDU0_Y19-3rOzbD6aw4rpktDapYrreY8RrhPhCWnR7SA
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSION=1536

# ---- 论文分析流水线 ----
ANALYSIS_PROMPT_VERSION=paper-analysis-v1
ANALYSIS_VERSION=v1
ANALYSIS_PARSER_VERSION=pymupdf-pdfplumber-v1
ANALYSIS_PDF_TIMEOUT_SECONDS=45
ANALYSIS_PDF_MAX_BYTES=52428800
ANALYSIS_CHUNK_TARGET_TOKENS=500
ANALYSIS_CHUNK_MAX_TOKENS=600
ANALYSIS_CHUNK_OVERLAP_TOKENS=50
ANALYSIS_MAX_RETRIES=3
ANALYSIS_HEARTBEAT_TIMEOUT_SECONDS=900
ANALYSIS_RECONCILE_INTERVAL_SECONDS=60
ANALYSIS_OUTBOX_BATCH_SIZE=50
ANALYSIS_OUTBOX_LEASE_SECONDS=120
ANALYSIS_RESULT_EXPIRES_SECONDS=86400
ANALYSIS_QUEUE=analysis
ANALYSIS_AUTO_REQUEUE_WORKER_LOST=true
CELERY_VISIBILITY_TIMEOUT_SECONDS=21600

# ---- arXiv API 配置 ----
ARXIV_USER_AGENT="PaperMate/1.0 (arxiv metadata client)"
ARXIV_CONTACT_EMAIL="YOUR_EMAIL"
ARXIV_TIMEOUT_SECONDS=60
ARXIV_REQUEST_INTERVAL_SECONDS=3
ARXIV_MAX_RETRIES=3
ARXIV_REDIS_LOCK_TIMEOUT_SECONDS=120
DIGEST_ARXIV_SYNC_HOUR=7
DIGEST_ARXIV_SYNC_MINUTE=0
DIGEST_ARXIV_LOOKBACK_HOURS=24
DIGEST_ARXIV_MAX_RESULTS_PER_SUBSCRIPTION=50
